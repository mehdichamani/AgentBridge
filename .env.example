# ==============================================================================
# AgentBridge Configuration Template (.env.example)
# Copy this file to .env and configure your remote environment:
#   cp .env.example .env
# ==============================================================================

# --- Remote Host & Connection ---
# Primary SSH host alias (defined in your ~/.ssh/config)
REMOTE_HOST="remote-server"

# Fast/Direct fallback host (e.g. WireGuard/LAN IP or Host)
# Leave empty if you don't use dual-routing.
FAST_HOST=""
FAST_HOST_PING=""

# --- Remote Project Directory ---
# The absolute path to the project directory on the remote host
REMOTE_PROJECT_DIR="/home/user/projects/my-awesome-app"

# Local mount point relative to this workspace
LOCAL_MOUNT_DIR="mnt"

# --- Network & SOCKS5 Proxy ---
DEFAULT_PROXY_PORT=1080
